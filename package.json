{
  "name": "beacon-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "bump-version": "node scripts/bump-version.mjs",
    "check": "biome check .",
    "dev": "pnpm build && node apps/cli/dist/cli.js",
    "test": "pnpm build && pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "pnpm build && pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "e2e:message": "pnpm typecheck && tsx --test e2e/message/*.e2e.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
