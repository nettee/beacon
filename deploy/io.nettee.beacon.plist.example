<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.nettee.beacon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/beacon</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/.beacon</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!--
    Beacon 0.6+ spawns Pi in a detached worker (new session / PGID), so a
    plain kill -9 of the daemon should not take in-flight Pi with it.
    AbandonProcessGroup is optional belt-and-suspenders on Mini LaunchDaemon:
    if true, launchd will not kill leftover processes that share the job PGID
    when the job exits. Prefer relying on code-side detach; set this only if
    you still see Pi die with the daemon after upgrading to 0.6+.
  -->
  <!--
  <key>AbandonProcessGroup</key>
  <true/>
  -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.beacon/logs/service.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.beacon/logs/service.stderr.log</string>
</dict>
</plist>
