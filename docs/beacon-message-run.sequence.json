{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Beacon 飞书消息端到端链路",
    "locale": "zh-CN",
    "output": "docs/beacon-message-run.html",
    "viewBox": [1040, 640],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "user", "type": "external", "label": "飞书用户", "sublabel": "私聊或群聊 @Bot" },
    { "id": "feishu", "type": "cloud", "label": "飞书应用", "sublabel": "Bot 身份与开放平台" },
    { "id": "beacon", "type": "backend", "label": "Beacon Service", "sublabel": "Gateway + Run 编排" },
    { "id": "profile", "type": "database", "label": "Profile 目录", "sublabel": "YAML + Prompt.md" },
    { "id": "outcome", "type": "security", "label": "Outcome CLI", "sublabel": "Run Capability" },
    { "id": "pi", "type": "backend", "label": "Pi RPC 进程", "sublabel": "每条消息全新 Run" },
    { "id": "workspace", "type": "database", "label": "Workspace", "sublabel": "代码与本地工具" },
    { "id": "model", "type": "cloud", "label": "模型 Provider", "sublabel": "由 Pi 配置与认证" }
  ],
  "messages": [
    { "id": "loadProfile", "from": "beacon", "to": "profile", "y": 164, "label": "启动：严格加载配置、Prompt 与凭证", "variant": "security" },
    { "id": "sendMessage", "from": "user", "to": "feishu", "y": 192, "label": "私聊或群聊 @Bot", "variant": "emphasis" },
    { "id": "receiveEvent", "from": "feishu", "to": "beacon", "y": 220, "label": "长连接：im.message.receive_v1", "variant": "emphasis" },
    { "id": "acknowledge", "from": "beacon", "to": "feishu", "y": 248, "label": "OnIt 表情确认", "variant": "dashed" },
    { "id": "fetchQuotes", "from": "beacon", "to": "feishu", "y": 276, "label": "沿 parent_id 递归读取引用链", "variant": "default" },
    { "id": "quotesReady", "from": "feishu", "to": "beacon", "y": 304, "label": "完整引用链（最旧 → 最新）", "variant": "return" },
    { "id": "startRun", "from": "beacon", "to": "pi", "y": 332, "label": "Prompt + Outcome Capability；spawn RPC 无 session Run", "variant": "emphasis" },
    { "id": "modelRequest", "from": "pi", "to": "model", "y": 360, "label": "调用 Profile 指定模型", "variant": "default" },
    { "id": "useTools", "from": "pi", "to": "workspace", "y": 388, "label": "按需执行工具与修改代码", "variant": "dashed" },
    { "id": "chooseOutcome", "from": "pi", "to": "outcome", "y": 420, "label": "submit_final_outcome(text) 工具调用", "variant": "emphasis" },
    { "id": "submitOutcome", "from": "outcome", "to": "beacon", "y": 452, "label": "Unix Socket：runToken + 最终文本", "variant": "security" },
    { "id": "runSettled", "from": "pi", "to": "beacon", "y": 484, "label": "agent_settled；普通 final response 不参与交付", "variant": "dashed" },
    { "id": "quotedReply", "from": "beacon", "to": "feishu", "y": 516, "label": "成功结果或明确失败的引用回复", "variant": "emphasis" },
    { "id": "showReply", "from": "feishu", "to": "user", "y": 548, "label": "展示显式提交的 Final Outcome", "variant": "return" }
  ],
  "activations": [
    { "participant": "beacon", "from": 160, "to": 172, "type": "backend" },
    { "participant": "feishu", "from": 188, "to": 310, "type": "cloud" },
    { "participant": "beacon", "from": 216, "to": 522, "type": "backend" },
    { "participant": "pi", "from": 328, "to": 490, "type": "backend" },
    { "participant": "model", "from": 356, "to": 366, "type": "cloud" },
    { "participant": "workspace", "from": 384, "to": 394, "type": "database" },
    { "participant": "outcome", "from": 416, "to": 458, "type": "security" },
    { "participant": "feishu", "from": 512, "to": 554, "type": "cloud" }
  ]
}
